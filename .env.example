# ===========================================================
#  CONFIGURACIÓN DEL SISTEMA — copia este archivo como ".env"
#  y rellena tus llaves. Sin llaves, la app corre en MODO DEMO
#  (simula pagos y guarda los correos en pantalla para probar).
# ===========================================================

# URL pública de tu app (sin slash final).
# En local: http://localhost:3000
# En producción: https://tu-dominio.com
BASE_URL=http://localhost:3000

# Puerto (Render/Railway lo ponen solo; en local usa 3000)
PORT=3000

# Contraseña para entrar al panel de administración (CRM + escáner).
# CÁMBIALA por algo tuyo.
ADMIN_PASSWORD=cambiame123

# Secreto para firmar las sesiones (pon cualquier texto largo y aleatorio)
SESSION_SECRET=pon-aqui-un-texto-largo-y-secreto

# ---------- STRIPE (cobros con tarjeta) ----------
# Saca estas llaves en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# El "Signing secret" del webhook (https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=

# ---------- RESEND (envío de correos) ----------
# Saca la API key en https://resend.com/api-keys
RESEND_API_KEY=
# Remitente verificado en Resend (ej: "Eventos <boletos@tudominio.com>")
# En modo prueba puedes usar: onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev
